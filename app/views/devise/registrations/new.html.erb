<section class="h-full flex items-center justify-center p-2">
  <div class="w-fit bg-white rounded-md shadow-[0_5px_80px_rgba(15,23,42,0.09)] border border-slate-50">
    <div class="w-full p-6 md:p-8">
      <h1 class="text-lg font-semibold tracking-tight text-center">Create your account</h1>
      <p class="mt-4 leading-7 text-sm">Set up access to manage leave requests, balances, and approvals in one place.</p>
      <%= form_for(resource, as: resource_name, url: registration_path(resource_name),
        data: { controller: "form-validation", action: "submit->form-validation#validateForm" } ) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <%# Email %>
        <div class="pt-3">
          <%= f.label :email, "Email address", class: "text-sm font-medium" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email",placeholder: "Enter your email",
          data:{form_validation_target: "input",validation_type: "email",validation_required: "true",validation_label: "Email",validation_error_id: "email-error",action: "blur->form-validation#validateField input->form-validation#handleInput"}, 
            class: "mt-2 w-full h-[35px] rounded-sm border border-slate-200 px-4 text-xs outline-none transition focus:border-primary" %>
          <span id="email-error" class="hidden text-red-500 text-xs mt-1 block"></span>
        </div>
        <%# Password %>
        <div class="pt-3">
          <div class="flex items-center justify-between gap-4">
            <%= f.label :password, class: "text-sm font-medium" %>
          </div>
          <div class="mt-4 flex h-[35px] items-center rounded-md border border-slate-200 transition focus-within:border-primary">
            <%= f.password_field :password,autocomplete: "new-password",placeholder: "Create a password",required: true,    
            data:{form_validation_target: "input",validation_type: "password",validation_required: "true",validation_label: "Password", validation_min_length: "6", validation_error_id: "password-error",action: "blur->form-validation#validateField input->form-validation#handleInput"},
            class: "h-full min-w-0 flex-1 border-0 bg-transparent px-4 text-xs outline-none focus:ring-0" %>
          </div>
          <span id="password-error" class="hidden text-red-500 text-xs mt-2 "></span>
        </div>
        <%# Confirm password %>
        <div class="pt-3">
          <%= f.label :password_confirmation, "Confirm password", class: "text-sm font-medium text-slate-900" %>
          <div class="mt-2 flex h-[35px] items-center rounded-md border border-slate-200 transition focus-within:border-primary">
            <%= f.password_field :password_confirmation, autocomplete: "new-password",placeholder: "Confirm your password",required: true,
            data:{form_validation_target: "input",validation_type: "password",validation_required: "true", validation_match: "#user_password", validation_label: "confirm password",validation_error_id: "confirm-password-error",action: "blur->form-validation#validateField input->form-validation#handleInput"},
            class: "h-full min-w-0 flex-1 border-0 bg-transparent px-4 text-xs outline-none focus:ring-0" %>
          </div>
          <span id="confirm-password-error" class="hidden text-red-500 text-xs mt-1 block"></span>
        </div>
        <%= f.submit "Sign up",
          class: "mt-4 inline-flex w-full items-center justify-center rounded-md bg-primary px-4 h-[35px] text-sm font-semibold text-white transition hover:bg-secondary focus:outline-none focus:ring-4 focus:ring-[#44652d]/20" %>
      <% end %>
      <%# Login link %>
      <div class="mt-4 text-center flex gap-2 justify-center">
        <p class="text-sm">Already have an account?</p>
        <%= link_to "Login", new_session_path(resource_name), class: "font-semibold text-primary text-sm hover:text-secondary" %>
      </div>
      <div class="mt-4 text-center flex flex-wrap items-center justify-center gap-2">
        <p class="text-sm">Didn't receive confirmation instructions?</p>
        <%= link_to "click here", new_confirmation_path(resource_name), class: "text-primary font-semibold text-sm hover:text-secondary" %>
      </div>
    </div>
  </div>
</section>
