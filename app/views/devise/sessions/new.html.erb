<section class="h-full flex items-center justify-center p-2">
  <div class="w-fit bg-white rounded-md shadow-[0_5px_20px_rgba(15,23,42,0.09)] border border-slate-50 flex ">
    <!-- Left Side -->
    <div class="w-full md:w-1/2 p-6 md:p-8">
      <h1 class="font-semibold mt-4 text-xl">Welcome back</h1>
      <p class="mt-3 text-sm sm:text-md leading-7">Sign in to continue managing leave requests, balances, and approvals.</p>
      <%= form_for(resource, as: resource_name, url: session_path(resource_name), 
       data: { controller: "form-validation", action: "submit->form-validation#validate" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <div class="field mt-4">
          <%= f.label :email, class:"text-sm" %>
          <%= f.email_field :email, autofocus: true, autocomplete: "email", placeholder: "Enter your email", required: true,
         data:{form_validation_target: "input",validation_type: "email",validation_required: "true",validation_label: "Email",validation_error_id: "email-error",action: "blur->form-validation#validateField input->form-validation#clearError"}, 
          class: "mt-2 w-full h-[35px] rounded-sm border border-slate-300 px-4 text-xs outline-none transition focus:border-primary"%>
          <span id="email-error" class="hidden text-red-500 text-xs mt-1 block"></span>
        </div>
        <div class="mt-4" >
          <div class="flex justify-between">
            <%= f.label :password, class:"text-sm"%>
            <%= link_to "Forgot your password?",new_password_path(resource_name),
            class: "text-xs sm:text-sm tracking-4 font-medium text-primary hover:text-secondary hover:underline" %>
          </div>
          <div>
            <%= f.password_field :password, autocomplete: "current-password", placeholder:"Enter your password",
           data:{form_validation_target: "input",validation_type: "password",validation_required: "true",validation_label: "Password",validation_min_length: "6",validation_error_id: "password-error",action: "blur->form-validation#validateField input->form-validation#clearError"},
          class: "w-full mt-2 h-[35px] rounded-sm border border-slate-300 px-4 text-xs outline-none transition focus:border-primary"%>
            <span id="password-error" class="hidden text-red-500 text-xs mt-1 block"></span>
          </div>
        </div>
        <div class="flex gap-2 pt-3">
          <%= f.check_box :remember_me %>
          <%= f.label :remember_me , class: "text-sm" %>
        </div>
        <div class="mt-4">
          <%= f.submit "Log in",
          class: "w-full h-[35px] rounded-sm bg-primary text-sm font-semibold text-white transition hover:bg-secondary focus:outline-none" %>
          <div class="flex flex-col items-center sm:flex-row justify-center gap-2 pt-3">
            <p class="text-sm sm:text-md">Don't have an account?</p>
            <%= link_to "Sign up",new_registration_path(resource_name),class: "font-semibold text-sm sm:text-md text-primary hover:text-secondary" %>
          </div>
          <div class="mt-4 flex justify-center gap-2">
            <p class="text-sm">Didn't receive unlock instructions?</p>
            <%= link_to "Click here", new_unlock_path(resource_name), class: "text-primary hover-text-primary text-sm font-semibold" %>
          </div>
        </div>
      <% end %>
    </div>
    <!-- Right Side Image -->
    <div class="hidden md:flex md:w-1/2 items-center justify-center">
      <%= image_tag "login.svg", alt: "Login image", class: "w-[80%] h-auto" %>
    </div>
  </div>
</section>