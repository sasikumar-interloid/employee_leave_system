<% if resource.errors.any? %>
  <div id="error_explanation" data-turbo-temporary data-controller="flash" class="absolute top-10 right-4 overflow-hidden rounded-md border border-rose-200 bg-rose-50 px-4 py-3 text-sm leading-6 text-rose-900 shadow-sm sm:px-5">
    <ul>
      <% resource.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
