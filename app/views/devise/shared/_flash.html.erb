<div class="fixed top-10 right-5 z-50 space-y-3" data-controller="flash">
  <% if notice.present? %>
    <div class="rounded-md border border-green-200 bg-green-50 px-4 py-3 text-sm text-green-900 shadow-sm">
      <%= notice %>
    </div>
  <% end %>

  <% if alert.present? %>
    <div class="rounded-md border border-rose-200 bg-rose-50 px-4 py-3 text-sm text-rose-900 shadow-sm">
      <%= alert %>
    </div>
  <% end %>
</div>