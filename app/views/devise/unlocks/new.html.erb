<section class="h-full flex justify-center items-center">
  <div class="flex justify-center p-4 sm:p-6 bg-white rounded-md shadow-[0_28px_80px_rgba(15,23,42,0.08)] border border-slate-100">
    <div class="p-4">
      <h1 class="text-center text-lg font-semibold tracking-tight text-slate-950">Unlock your access</h1>
      <p class="mt-4 text-sm leading-7">Request a new unlock email to regain access to the portal.</p>
      <%= form_for(resource, as: resource_name, url: unlock_path(resource_name), 
      data: { controller: "form-validation", action: "submit->form-validation#validate" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <div class="mt-3">
          <%= f.label :email, class: "text-sm" %>
          <%= f.email_field :email,  placeholder: "Enter your email", autofocus: true, autocomplete: "email", required: true,
          data:{form_validation_target: "input",validation_type: "email",validation_required: "true",validation_label: "Email",validation_error_id: "email-error",action: "blur->form-validation#validateField input->form-validation#clearError"}, 
          class: "mt-2 block h-[35px] w-full rounded-sm border border-slate-200 bg-white px-4 text-sm text-slate-900 shadow-sm outline-none transition placeholder:text-slate-400 focus:border-primary" %>
          <span id="email-error" class="hidden text-red-500 text-xs mt-1 block"></span>
        </div>
        <div>
          <%= f.submit "Resend unlock instructions", class: "mt-4 inline-flex h-[35px] w-full items-center justify-center rounded-sm bg-primary px-4 text-sm font-semibold text-white transition hover:bg-secondary focus:outline-none" %>
        </div>
        <div class="flex justify-center gap-2 pt-4">
          <p>Received email ?</p>
          <%= link_to "Log in", new_session_path(resource_name), class: "text-primary font-bold hover-text-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</section>