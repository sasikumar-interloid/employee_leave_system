<section class="h-screen flex justify-center items-center">
  <div class="rounded-md bg-white border border-slate-100 shadow-[0_5px_20px_rgba(15,23,42,0.09)] p-4">
    <div class="p-6">
      <h1 class="text-center text-lg font-semibold tracking-tight text-slate-950">Confirm your address</h1>
      <p class="mt-4 text-sm leading-7">Request a fresh confirmation email if your original link expired or never arrived.</p>
      <%= form_for(resource,as: resource_name,url: confirmation_path(resource_name), 
      data: { controller: "form-validation", action: "submit->form-validation#validateForm" }) do |f| %>
        <%= render "devise/shared/error_messages", resource: resource %>
        <!-- Email -->
        <div class="mt-3">
          <%= f.label :email, "Email address", class: "text-sm font-medium" %>
          <%= f.email_field :email,autofocus: true, autocomplete: "email", required: true,
          data:{form_validation_target: "input",validation_type: "email",validation_required: "true",validation_label: "Email",validation_error_id: "email-error",action: "blur->form-validation#validateField input->form-validation#handleInput"},
          placeholder: "Enter your email",class: "mt-2 w-full h-[35px] rounded-sm border border-slate-200 px-4 text-sm outline-none transition focus:border-primary" %>
          <span id="email-error" class="hidden text-red-500 text-xs mt-1 block"></span>
        </div>
        <%= f.submit "Resend confirmation instructions",
          class: "mt-3 w-full h-[35px] items-center justify-center rounded-sm bg-primary px-4 text-sm font-semibold text-white transition hover:bg-secondary focus:outline-none" %>
      <% end %>
    </div>
    <!-- Footer -->
    <div class="mt-8 text-center text-sm flex-col sm:flex-row justify-center gap-2">
      <p>Remembered your password?</p>
      <%= link_to "Login",new_session_path(resource_name),class: "font-semibold text-primary hover:text-secondary" %>
    </div>
  </div>
</div>
</section>